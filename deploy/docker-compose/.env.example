# Copy this file to .env and replace this development placeholder before starting.
# Generate the application secrets with: openssl rand -base64 48
# Generate the MongoDB password with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
CREDENTIAL_MASTER_KEY=replace-with-at-least-32-random-bytes
MONGODB_USERNAME=litemcp
MONGODB_PASSWORD=replace-with-uri-safe-random-password
MONGODB_REPLICA_SET_KEY=replace-with-at-least-32-random-bytes

LITEMCP_VERSION=local
API_ORIGIN=http://localhost:8787
BETTER_AUTH_URL=http://localhost:8080
SIGNUPS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
APPROVAL_WEBHOOK_URL=
SERVER_PORT=8787
WEB_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Payload-free tenant usage analytics (Mongo time-series retention and queue).
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_MAX_QUEUE_SIZE=10000
ANALYTICS_BATCH_SIZE=250
ANALYTICS_FLUSH_INTERVAL_MS=100

# Optional local governance limits. Defaults keep the self-hosted product
# effectively unlimited and do not involve a license or call-home service.
LITEMCP_QUOTA_SERVERS=9007199254740991
LITEMCP_QUOTA_COMPOSITIONS=9007199254740991
LITEMCP_QUOTA_ACTIVE_SESSIONS=9007199254740991
LITEMCP_QUOTA_TOOL_CALLS_PER_DAY=9007199254740991
