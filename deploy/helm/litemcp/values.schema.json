{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "LiteMCP Composer Helm values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "image": {
      "type": "object",
      "required": ["server", "web"],
      "properties": {
        "server": { "$ref": "#/definitions/image" },
        "web": { "$ref": "#/definitions/image" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "existingConfigMap": { "type": "string" },
        "webOrigin": { "type": "string", "minLength": 1 },
        "apiOrigin": { "type": "string", "minLength": 1 },
        "extraData": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "uri": { "type": "string" },
        "existingSecret": { "type": "string" },
        "annotations": { "type": "object" },
        "key": { "$ref": "#/definitions/secretKey" },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "anyOf": [{ "maxLength": 0 }, { "minLength": 32 }]
        },
        "existingSecret": { "type": "string" },
        "annotations": { "type": "object" },
        "key": { "$ref": "#/definitions/secretKey" }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["server", "web"],
      "properties": {
        "server": { "$ref": "#/definitions/autoscaling" },
        "web": { "$ref": "#/definitions/autoscaling" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["server", "web"],
      "properties": {
        "server": { "$ref": "#/definitions/podDisruptionBudget" },
        "web": { "$ref": "#/definitions/podDisruptionBudget" }
      }
    },
    "server": { "$ref": "#/definitions/component" },
    "web": { "$ref": "#/definitions/component" },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType", "service"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    },
                    "service": { "type": "string", "enum": ["server", "web"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "serverEgress": { "type": "array" },
        "webEgress": { "type": "array" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[-._A-Za-z0-9]+$"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "behavior": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "demoMode": { "type": "boolean" },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "deploymentAnnotations": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" },
            "sessionAffinity": { "type": "string", "enum": ["None", "ClientIP"] }
          }
        },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "resources": { "type": "object" },
        "env": { "type": "array" },
        "envFrom": { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "extraVolumes": { "type": "array" },
        "initContainers": { "type": "array" },
        "sidecars": { "type": "array" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" },
        "priorityClassName": { "type": "string" },
        "runtimeClassName": { "type": "string" }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
