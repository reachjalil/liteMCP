    "test": "vitest run src",
    "types": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@litemcp/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
