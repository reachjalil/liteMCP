---
import PageHero from "../components/PageHero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const engineeringRecords = [
  [
    "Architecture",
    "Control and data plane architecture",
    "Read the maintained component boundaries, dependency direction, runtime compositions, and portability constraints.",
    "https://github.com/reachjalil/liteMCP/blob/main/ARCHITECTURE.md",
  ],
  [
    "Security",
    "MCP threat model",
    "Review tenant, identity, policy, credential, egress, approval, audit, and analytics trust boundaries with current mitigations and gaps.",
    "https://github.com/reachjalil/liteMCP/blob/main/docs/security/threat-model.md",
  ],
  [
    "Evidence",
    "Implementation status",
    "Follow reproducible proof, acceptance scenarios, maturity labels, and the work that remains before production-readiness claims.",
    "https://github.com/reachjalil/liteMCP/blob/main/IMPLEMENTATION_STATUS.md",
  ],
];
---

<SiteLayout title="Engineering records" description="Maintained LiteMCP Composer architecture, security, and implementation evidence in the public repository.">
  <PageHero
    eyebrow="Engineering records"
    title="Read maintained evidence, not an editorial queue."
    description="LiteMCP engineering decisions, security boundaries, acceptance results, and known limitations live beside the code so claims can link to exact implementations and tests."
    signal="Repository-backed · current maturity labeled"
    compact
  />

  <section class="content-section">
    <div class="shell blog-grid">
      {engineeringRecords.map(([category, title, description, href]) => (
        <a class="blog-card" href={href}>
          <div class="blog-card__meta"><span>{category}</span><span>Maintained source ↗</span></div>
          <h2>{title}</h2>
          <p>{description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="content-section content-section--tight">
    <div class="shell legal-note">
      There is no publication cadence or newsletter commitment. Release changes are recorded in
      the repository with their implementation and validation evidence.
    </div>
  </section>
</SiteLayout>
