---
import { LoginApp } from "../components/auth/LoginApp";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_API_ORIGIN ?? import.meta.env.API_ORIGIN ?? "";
const demoMode = import.meta.env.LITEMCP_DEMO_MODE === "true";
const signupsEnabled = demoMode || import.meta.env.SIGNUPS_ENABLED === "true";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sign in to the LiteMCP Composer preview with a configured Better Auth provider or local account; live enterprise federation remains unproven." />
    <meta name="theme-color" content="#080b10" />
    <link rel="icon" href="/favicon.svg" />
    <title>Sign in — LiteMCP Composer</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("litemcp-theme");
      document.documentElement.dataset.theme = storedTheme || "dark";
    </script>
  </head>
  <body>
    <LoginApp client:load apiBaseUrl={apiBaseUrl} demoMode={demoMode} signupsEnabled={signupsEnabled} />
  </body>
</html>
