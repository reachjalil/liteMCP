---
import SiteLayout from "../layouts/SiteLayout.astro";

const capabilities = [
  {
    index: "01",
    title: "Compose",
    description: "Put built-in and remote tools behind one stable, namespaced endpoint.",
  },
  {
    index: "02",
    title: "Govern",
    description: "Apply default-deny policy at discovery and again before execution.",
  },
  {
    index: "03",
    title: "Prove",
    description: "Bind one-shot approval to exact context and record payload-free evidence.",
  },
];
---

<SiteLayout description="Govern MCP access through one identity-aware endpoint with filtered discovery, exact-context approvals, and payload-free evidence.">
  <section class="home-hero">
    <div class="shell home-hero__inner">
      <div class="home-hero__stage">
        <div class="home-hero__copy">
          <p class="eyebrow">Open-source MCP governance</p>
          <h1 class="home-hero__headline">Govern every MCP call.</h1>
          <p class="home-hero__description">
            Put approved MCP servers behind one identity-aware endpoint. Filter tools by role,
            approve sensitive actions, and record evidence without retaining arguments or results.
          </p>
          <div class="home-hero__actions">
            <a class="button button--accent button--large" href="/docs/getting-started#five-minute-proof">Run the proof</a>
            <a class="button button--inverted button--large" href="/design-partners">Apply for a pilot</a>
          </div>
        </div>

        <aside class="proof-terminal" aria-label="Five-minute local product proof">
          <div class="proof-terminal__header">
            <span>Five-minute proof</span>
            <span>Local</span>
          </div>
          <div class="proof-terminal__command">
            <span aria-hidden="true">$</span>
            <code>pnpm demo:smoke</code>
          </div>
          <ul>
            <li><span>PASS</span> Identity-filtered discovery</li>
            <li><span>PASS</span> Guessed-call denial</li>
            <li><span>PASS</span> Exact-context approval</li>
            <li><span>PASS</span> Payload-free evidence</li>
          </ul>
          <a href="/docs/getting-started#five-minute-proof">See what the proof covers <span aria-hidden="true">↗</span></a>
        </aside>
      </div>

      <div class="home-hero__meta" aria-label="Product availability">
        <span><b>01</b> Apache 2.0</span>
        <span><b>02</b> Self-hostable</span>
        <span><b>03</b> No hosted account required</span>
      </div>
    </div>
  </section>

  <section class="home-capabilities" aria-label="Core capabilities">
    <div class="shell home-capabilities__grid">
      {capabilities.map((capability) => (
        <article>
          <span>{capability.index}</span>
          <h2>{capability.title}</h2>
          <p>{capability.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="home-choice">
    <div class="shell home-choice__inner">
      <div>
        <p class="eyebrow">Open core, clear boundary</p>
        <h2>Run it yourself. Or pilot it with us.</h2>
        <p>
          The complete self-hosted product is Apache 2.0. Managed Cloud is currently available as
          a qualified design-partner pilot.
        </p>
      </div>
      <div class="home-choice__actions">
        <a class="button button--primary" href="/docs/getting-started">Self-host LiteMCP</a>
        <a class="button" href="/design-partners">Review pilot fit</a>
      </div>
    </div>
    <p class="shell home-choice__status">Pre-1.0 · local proof passed · production acceptance in progress</p>
  </section>
</SiteLayout>
