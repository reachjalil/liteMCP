---
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const services = [
  [
    "Architecture and preflight",
    "Topology, threat model, capacity, ingress, identity, storage, vault, and observability review.",
  ],
  [
    "Installation and migration",
    "Repeatable deployment, existing MCP inventory import, policy translation, and cutover support.",
  ],
  [
    "HA and recovery",
    "Replica strategy, disruption budgets, backups, restore drills, rollback, and disaster-recovery exercises.",
  ],
  [
    "Identity integration",
    "OIDC, SAML, SCIM, group mappings, service principals, and existing vault or KMS integration.",
  ],
  [
    "Supported operations",
    "LTS planning, upgrade assistance, security patch response, diagnostics, and named escalation paths.",
  ],
  [
    "Restricted environments",
    "Private registry mirroring, signed artifact transfer, offline installation, and air-gap runbooks.",
  ],
];
---

<SiteLayout title="Enterprise on-prem services" description="The intended LiteMCP Composer enterprise model funds accountable deployment and operations around the open product; commercial terms are not yet published.">
  <PageHero
    eyebrow="Enterprise on-prem · Planned services"
    title="The commercial model is accountability, not permission."
    description="Future LiteMCP Composer engagements are intended to cover installation, integration, upgrades, reliability, security response, and support inside customer environments. No current SLA or production service commitment is asserted."
    signal="Planned services, no feature gates"
  >
    <Fragment slot="actions">
      <a class="button button--primary button--large" href="mailto:enterprise@litemcpcomposer.com">Discuss a design partnership</a>
      <a class="button button--large" href="/docs/self-hosting">Review self-hosting</a>
    </Fragment>
  </PageHero>

  <section class="content-section">
    <div class="shell">
      <SectionHeader
        eyebrow="Engagement scope"
        title="A planned service scope around a public codebase."
        description="A future contract can define deliverables, response commitments, environments, release lines, and ownership without creating a private product fork."
      />
      <div class="feature-grid">
        {services.map(([title, description], index) => (
          <article class="feature-card">
            <span class="feature-card__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section content-section--subtle">
    <div class="shell">
      <SectionHeader eyebrow="Boundary" title="What a services contract does and does not buy." />
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead><tr><th>Open-source maturity</th><th>Potential contracted operations</th></tr></thead>
          <tbody>
            <tr><td>Policy and audit available; SSO/SCIM wiring and approvals in preview</td><td>IdP implementation, mapping review, and lifecycle runbooks</td></tr>
            <tr><td>Docker images and Helm renders in preview; live HA/recovery proof pending</td><td>Environment design, installation, validation, and recovery drills</td></tr>
            <tr><td>Security fixes and public advisories</td><td>Defined response targets, supported patch windows, and escalation</td></tr>
            <tr><td>Stable/LTS release mechanisms planned</td><td>Upgrade planning, compatibility assessment, and assisted rollback</td></tr>
            <tr><td>Audit export in preview; OpenTelemetry and SIEM integrations planned</td><td>Integration with your SIEM, traces, metrics, and on-call process</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="content-section content-section--tight">
    <div class="shell legal-note">
      No enterprise service is represented as generally available here. Certifications,
      availability SLAs, support response times, named LTS dates, pricing, and contractual terms
      are not yet published.
    </div>
  </section>
</SiteLayout>
