---
import { ConsoleApp } from "../components/console/ConsoleApp";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_API_ORIGIN ?? import.meta.env.API_ORIGIN ?? "";
const defaultDemoMode = import.meta.env.LITEMCP_DEMO_MODE === "true";
const demoModeAvailable = defaultDemoMode;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Operate MCP servers, compositions, identities, policy decisions, approvals, and audit evidence."
    />
    <meta name="theme-color" content="#080b10" />
    <link rel="icon" href="/favicon.svg" />
    <title>Console — LiteMCP Composer</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("litemcp-theme");
      document.documentElement.dataset.theme = storedTheme || "dark";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#console-content">Skip to console content</a>
    <ConsoleApp
      client:only="react"
      apiBaseUrl={apiBaseUrl}
      defaultDemoMode={defaultDemoMode}
      demoModeAvailable={demoModeAvailable}
    />
    <noscript>This control plane requires JavaScript to load and mutate API data.</noscript>
  </body>
</html>
