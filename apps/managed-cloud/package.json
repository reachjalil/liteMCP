{
  "name": "@litemcp/managed-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "auth:schema": "tsx scripts/print-auth-migration.ts",
    "build": "pnpm wrangler:dry-run",
    "build:web": "node scripts/build-web.mjs production",
    "build:web:staging": "node scripts/build-web.mjs staging",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --env= --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --env= --remote",
    "db:migrate:staging": "wrangler d1 migrations apply AUTH_DB --env staging --remote",
    "dev": "pnpm build:web && wrangler dev --env=",
    "deploy": "pnpm build:web && wrangler deploy --env=",
    "deploy:staging": "pnpm build:web:staging && wrangler deploy --env staging",
    "test": "vitest run --passWithNoTests",
    "types": "tsc -p tsconfig.json && wrangler types worker-configuration.d.ts",
    "wrangler:dry-run": "pnpm build:web && wrangler deploy --dry-run --env= --outdir dist",
    "wrangler:dry-run:staging": "pnpm build:web:staging && wrangler deploy --dry-run --env staging --outdir dist/staging"
  },
  "dependencies": {
    "@litemcp/adapter-cloudflare": "workspace:*",
    "@litemcp/analytics": "workspace:*",
    "@litemcp/auth": "workspace:*",
    "@litemcp/core": "workspace:*",
    "@litemcp/mcp-gateway": "workspace:*",
    "@litemcp/platform-api": "workspace:*",
    "@sentry/cloudflare": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@litemcp/web": "workspace:*",
    "typescript": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
