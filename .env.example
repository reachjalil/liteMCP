# Public runtime
WEB_ORIGIN=http://localhost:4321
API_ORIGIN=http://localhost:8787
LITEMCP_DEMO_MODE=true
LITEMCP_INSECURE_DEV=false
SIGNUPS_ENABLED=true

# Better Auth. Generate at least 32 random bytes outside source control.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8787

# Transactional email. Both RESEND_API_KEY and EMAIL_FROM are required before
# SIGNUPS_ENABLED may be true outside demo/insecure-development mode.
RESEND_API_KEY=
# For example: LiteMCP Composer <no-reply@example.com>
EMAIL_FROM=
EMAIL_REPLY_TO=

# Portable NoSQL persistence (Docker/Kubernetes)
MONGODB_URI=mongodb://localhost:27017/litemcp?replicaSet=rs0
MONGODB_DATABASE=litemcp

# Payload-free usage analytics. The runtime default is disabled when this flag
# is absent; this example enables the Insight Plane with bounded Mongo batching.
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_MAX_QUEUE_SIZE=10000
ANALYTICS_BATCH_SIZE=250
ANALYTICS_FLUSH_INTERVAL_MS=100

# Optional deployment-local governance limits. Self-hosted defaults are
# effectively unlimited; set finite safe integers only when your operator wants
# local capacity guardrails. These are never populated by a license service.
LITEMCP_QUOTA_SERVERS=9007199254740991
LITEMCP_QUOTA_COMPOSITIONS=9007199254740991
LITEMCP_QUOTA_ACTIVE_SESSIONS=9007199254740991
LITEMCP_QUOTA_TOOL_CALLS_PER_DAY=9007199254740991

# Optional local envelope-encryption key. Use KMS/Vault in production.
CREDENTIAL_MASTER_KEY=

# Optional generic JSON/Slack-compatible webhook for approval notifications.
APPROVAL_WEBHOOK_URL=

# Optional enterprise identity bootstrap. Tenant IdP configuration can also
# be registered through the API after an administrator signs in.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# Unsafe evaluation-only host execution. Keep disabled in production; use an
# isolated runner instead.
LITEMCP_ENABLE_UNSAFE_HOST_STDIO=false
LITEMCP_STDIO_ALLOWLIST=
